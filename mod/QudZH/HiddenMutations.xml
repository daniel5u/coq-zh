    <mutation Name="Repelling Force" DisplayName="排斥力场" BearerDescription="排斥者">
      <description>
                    <p>你在四周激起一股排斥之力，将敌人击退。</p>
                </description>
      <leveltext>
                    <statline Name="Area" DisplayName="范围" />
                    <switch Name="LevelMatch">
                        <case Value="true"><p>范围内的生物会被推离爆心。</p></case>
