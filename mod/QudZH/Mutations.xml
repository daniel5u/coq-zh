<?xml version='1.0' encoding='utf-8'?>
<mutations Lang="zh" Encoding="utf-8">
  <category Name="Morphotypes" DisplayName="{{W|形态型}}">
    <mutation Name="Chimera" DisplayName="奇美拉">
      <description>
                    <p>你只会显现身体变异，且每次显现新变异时，你所面对的选项全为身体变异。</p>
                    <br />
                    <p>每当你显现新变异时，其中一个选项还会令你随机长出一条新肢体。</p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Esper" DisplayName="灵能者">
      <description>
                    <p>你只会显现精神变异，且每次显现新变异时，你所面对的选项全为精神变异。</p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Unstable Genome" DisplayName="不稳定基因组">
      <description>
                    <p>每购买一次此项，你便多获得一个变异，但这些变异不会立即显现。</p>
                    <p>每当你升级时，有33%的几率令你的基因失稳，让你从3个随机变异中择一。</p>
                </description>
      <leveltext />
    </mutation>
  </category>
  <category Name="Physical" DisplayName="{{G|肉体变异}}">
    <mutation Name="Adrenal Control" DisplayName="肾上腺控制" BearerDescription="掌控肾上腺者">
      <description>
                    <p>你能调节体内肾上腺素的分泌。</p>
                </description>
      <leveltext>
                    <p>你可加快体内肾上腺素的奔流，持续<stat Name="Duration" />。</p>
                    <p>肾上腺素奔流期间，你的迅捷+<stat Name="QuicknessBonus" />，其他身体变异的等级+<stat Name="MutationBonus" Unit="级" />。</p>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Beak" DisplayName="喙" BearerDescription="生喙者">
      <description>
                    <p>你的面上生着一只颇为雅致的<stat Name="BeakName" />。</p>
                    <br />
                    <p>自我+1</p>
                    <p>你偶尔会啄击对手。</p>
                    <p><gametext>与{{w|=faction:Birds=}}的声望+200</gametext></p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Burrowing Claws" DisplayName="掘地利爪" BearerDescription="穴居掘进者">
      <description>
                    
                    <p>你生有铲状的利爪，可掘土穿地。</p>
                </description>
      <leveltext>
                    <p><gametext>=weapon.Name=</gametext>对墙壁的穿透力：<stat Name="WallPenetration" /></p>
                    <p><gametext>=weapon.Name|pluralize=</gametext>在<stat Name="WallHits" Unit="次穿透命中" />后毁去墙壁。</p>
                    <switch Name="PrereleaseContent"><case Value="true"><p>脱离战斗时，可向上或向下掘出通道</p></case></switch>
                    <p><gametext>=weapon.Name|pluralize=同时也是一种=weaponClass.name=类天然武器，对非墙壁目标造成<stat Name="Damage" />点基础伤害。</gametext></p>
                </leveltext>
    </mutation>
    <mutation Name="Carapace" DisplayName="甲壳" BearerDescription="披甲壳者">
      <description>
                    
                    <p>你身披一层坚固的甲壳。</p>
                </description>
      <leveltext>
                    <p><stat Name="AV" Filters="signed" /> 护甲值</p>
                    <p><stat Name="DV" Filters="signed" /> 闪避值</p>
                    <p><stat Name="HeatResist" Filters="signed" /> 热抗</p>
                    <p><stat Name="ColdResist" Filters="signed" /> 寒冷抗性</p>
                    <switch Name="AddsRep"><case Value="" /><default><p><stat Name="AddsRep" /></p></default></switch>
                    <p>只要保持不动，你便可收紧<stat Name="CarapaceName" />，获得双倍的护甲值加成，代价是闪避值-2。</p>
                    <p>无法穿戴身甲。</p>
                </leveltext>
    </mutation>
    <mutation Name="Corrosive Gas Generation" DisplayName="腐蚀性气体生成" BearerDescription="喷吐腐蚀气体者">
      <description>
                    <p>你在自身周围释放一团<stat Name="GasName" />。</p>
                </description>
      <leveltext>
                    <p>释放气体，持续<stat Name="Duration" /></p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|<stat Name="LevelEffectDescription" />提高}}</p></case>
                        <case Value="lower"><p>{{rules|<stat Name="LevelEffectDescription" />降低}}</p></case>
                    </switch>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Double-muscled" DisplayName="双倍肌肉" BearerDescription="双倍肌肉者">
      <description>
                    <p>你生就一身魁伟的力气。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="Strength" /> 力量</p>
                    <p>近战攻击命中时，有<stat Name="DazeChance" />%的几率令对手迷乱2-3回合</p>
                </leveltext>
    </mutation>
    <mutation Name="Electrical Generation" DisplayName="电能生成" BearerDescription="生电者">
      <description>
                    <p>你能积蓄电荷，并以之放电伤敌。</p>
                </description>
      <leveltext>
                    <p>最大电荷：<stat Name="MaxCharge" /></p>
                    <p>每回合基础积蓄<stat Name="BaseChargePerTurn" />点电荷</p>
                    <p>可释放全部储存电荷，每<stat Name="DischargeChunk" />点电荷造成1d4伤害</p>
                    <p>放电可电弧跳跃至相邻目标，造成削减后的伤害，每<stat Name="DischargeChunk" />点电荷至多波及1个目标</p>
                    <p>电磁脉冲会令你不由自主地放电（难度18的意志豁免）</p>
                    <switch Name="CanDrinkTransient">
                        <case Value="true"><p>你可从电力源中汲取电荷。</p></case>
                        <default><p>你可从能量电池和电容器中汲取电荷。</p></default>
                    </switch>
                    <p>你每受到1点电击伤害，便获得<stat Name="DamageAbsorbFactor" />点电荷。</p>
                    <p>你可为所装备的自带电源装置供电。</p>
                </leveltext>
    </mutation>
    <mutation Name="Electromagnetic Pulse" DisplayName="电磁脉冲" BearerDescription="发射电磁脉冲者">
      <description>
                    <p>你产生一道电磁脉冲，使附近的古器与机械失效。</p>
                </description>
      <leveltext>
                    <p>范围：以你为中心的<stat Name="Area" /></p>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Flaming Ray" DisplayName="烈焰射线" BearerDescription="掌燃烈焰者">
      <description>
                    <p>你<switch Name="BodyPartName"><case Value="" /><default>从<stat Name="BodyPartName" /></default></switch>喷出一道烈焰射线。</p>
                </description>
      <leveltext>
                    <p>向你所选的方向射出一道<stat Name="Range" />格长的火焰射线。</p>
                    <statline Name="Damage" DisplayName="伤害" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                    <p>近战攻击使对手升温<stat Name="HeatOnHit" Unit="度" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Freezing Ray" DisplayName="冰冻射线" BearerDescription="手冻如冰者">
      <description>
                    <p>你<switch Name="BodyPartName"><case Value="" /><default>从<stat Name="BodyPartName" /></default></switch>喷出一道寒霜射线。</p>
                </description>
      <leveltext>
                    <p>朝你所选的方向射出一道长<stat Name="Range" />格的寒霜射线。</p>
                    <statline Name="Damage" DisplayName="伤害" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                    <p>近战攻击使对手降温<stat Name="CoolOnHit" Unit="度" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Hearing" DisplayName="敏锐听觉" BearerDescription="听觉敏锐者">
      <description>
                    <p>你生就异乎寻常的灵敏听觉。</p>
                </description>
      <leveltext>
                    <p>你能察觉半径<stat Name="Radius" />以内的生物。</p>
                    <switch Name="LevelMatch">
                        <case Value="true"><p>有几率辨识附近已察觉的生物</p></case>
                        <default><p>{{rules|辨识附近已察觉生物的几率提高}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Quickness" DisplayName="迅捷提升" BearerDescription="迅捷者">
      <description>
                    <p>你天赋异禀，迅疾非常。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="SpeedBonus" /> 迅捷</p>
                </leveltext>
    </mutation>
    <mutation Name="Horns" DisplayName="角" BearerDescription="生角者">
      <description>
                    <p><gametext>=horns.A.name.or.plural==horns.verb:突出=于你的头顶。</gametext></p>
                </description>
      <leveltext>
                    <p>近战攻击时有20%的几率顶刺对手</p>
                    <statline Name="Damage" DisplayName="伤害增量" />
                    <statline Name="ToHitBonus" DisplayName="命中加值" />
                    <switch Name="LevelMode">
                        <case Value="BleedBonus"><p>{{rules|流血豁免难度与流血强度提高}}</p></case>
                        <case Value="LevelUp"><p>{{rules|流血豁免难度提高}}</p></case>
                        <default><p>顶刺攻击可能造成流血</p></default>
                    </switch>
                    <p><gametext>=horns.Name==horns.verb:是=一种短刃类天然武器。</gametext></p>
                    <p>+<stat Name="AV" /> 护甲值</p>
                    <p>无法佩戴头盔</p>
                    <p><gametext>与{{w|=faction:Antelopes=}}和{{w|=faction:Goatfolk=}}的声望+100</gametext></p>
                </leveltext>
    </mutation>
    <mutation Name="Metamorphosis" DisplayName="蜕变" BearerDescription="变形者">
      <description>
                    <p>你可化为所触碰的任何生物的形貌。</p>
                </description>
      <leveltext>
                    <p>只能化为等级不超过<stat Name="MaxLevel" />的生物之形。</p>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Multiple Arms" DisplayName="多臂" BearerDescription="多臂者">
      <description>
                    <p>你多生了一对手臂。</p>
                </description>
      <leveltext>
                    <p>每当你发动近战攻击时，每条额外手臂各有<stat Name="AttackChance" />%的几率再发动一次近战攻击</p>
                </leveltext>
    </mutation>
    <mutation Name="Multiple Legs" DisplayName="多腿" BearerDescription="多足者">
      <description>
                    <p>你多生了一对腿。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="MoveSpeed" /> 移动速度</p>
                    <p>+<stat Name="CarryCapacity" />% 负重上限</p>
                </leveltext>
    </mutation>
    <mutation Name="Night Vision" DisplayName="夜视" BearerDescription="暗视者">
      <description>
                    <p>你能在暗中视物。</p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Phasing" DisplayName="相位穿行" BearerDescription="相位穿行者">
      <description>
                    <p>你可在短暂时间内穿越实体物件。</p>
                </description>
      <leveltext>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Photosynthetic Skin" DisplayName="光合作用皮肤" BearerDescription="绿肤者">
      <description>
                    <p>你的青翠皮肤坚韧强健，吸纳日光，以滋养自身。</p>
                </description>
      <leveltext>
                    <p>你可沐浴日光，以代替进食一餐，获得特殊的代谢效果，持续<stat Name="DurationDay" Unit="日" />：自然愈合速率+<stat Name="BonusRegen" />，迅捷+<stat Name="BonusQuickness" /></p>
                    <p>身处日光之下时，你会积蓄淀粉与木质素，可作烹饪膳食的食材（每种至多<stat Name="StarchServings" Unit="份" />）。</p>
                    <p>与植被处于同一格时，闪避值+<stat Name="BonusCamoflage" /></p>
                    <p>与{{w|根茎}}、{{w|树木}}、{{w|藤蔓}}以及{{w|植体联盟}}的声望+200</p>
                </leveltext>
    </mutation>
    <mutation Name="Quills" DisplayName="棘刺" BearerDescription="生刺者">
      <description>
                    
                    <p>成百上千的针尖利刺覆满你的周身。</p>
                </description>
      <leveltext>
                    <switch Name="LevelMatch">
                        <case Value="true"><p><stat Name="MaxQuills" /> <stat Name="Quills" /></p></case>
                        <default><p>+{{rules|80-120}} <stat Name="Quills" /></p></default>
                    </switch>
                    <p>可将你<stat Name="Quills" />的10%向四周迸射而出（<gametext>=pv=<stat Name="QuillPen" /> =damage=<stat Name="QuillDamage" /></gametext>）</p>
                    <p>每回合约再生<stat Name="RegenRate" />根<stat Name="Quills" /></p>
                    <p>只要保有一半的<stat Name="Quills" />，护甲值+<stat Name="AV" />（否则护甲值+<stat Name="AVWithPenalty" />）</p>
                    <p>近战攻击你的生物可能刺伤自身于你的<stat Name="Quills" />之上，约有1%的几率折断，每折断一根<stat Name="Quill" />便反弹3%的伤害。</p>
                    <p>无法穿戴身甲</p>
                    <p>免疫其他生物的<stat Name="Quills" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Regeneration" DisplayName="再生" BearerDescription="再生者">
      <description>
                    <p>你的伤口愈合得极快。</p>
                </description>
      <leveltext>
                    <p>你在战斗中亦可享有完整的自然愈合速率。</p>
                    <p>自然愈合速率加快<stat Name="RegenBonus" />%</p>
                    <p>每回合有<stat Name="RegenChance" />%的几率重新长出一条缺失的肢体</p>
                    <switch Name="NoDecapitate">
                        <case Value="false" />
                        <default><p>{{rules|你不会被斩首。}}</p></default>
                    </switch>
                    <switch Name="LevelBelow5">
                        <case Value="true"><p>每回合有<stat Name="DebuffChance" />%的几率随机解除一项{{rules|轻微的身体减益}}</p></case>
                        <default><p>每回合有<stat Name="DebuffChance" />%的几率随机解除一项{{rules|身体减益}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Sleep Gas Generation" DisplayName="睡眠气体生成" BearerDescription="喷吐催眠气体者">
      <description>
                    <p>你在自身周围释放一团<stat Name="GasName" />。</p>
                </description>
      <leveltext>
                    <p>释放气体，持续<stat Name="Duration" /></p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|<stat Name="LevelEffectDescription" />提高}}</p></case>
                        <case Value="lower"><p>{{rules|<stat Name="LevelEffectDescription" />降低}}</p></case>
                        <default />
                    </switch>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Slime Glands" DisplayName="黏液腺" BearerDescription="喷黏液者">
      <description>
                    <p>你分泌一种黏稠的黏液，可向目标吐去。</p>
                    <br />
                    <p>以黏液覆盖一片区域</p>
                    <statline Name="Range" DisplayName="射程" />
                    <statline Name="Area" DisplayName="范围" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                    <p>你行走于黏液之上不会滑倒。</p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Spinnerets" DisplayName="吐丝器" BearerDescription="织网者">
      <description>
                    <p>你能吐丝结出黏性的蛛网。</p>
                </description>
      <leveltext>
                    <p>结网期间，你每移动一步都会在身后留下蛛网。</p>
                    <switch Name="LevelMatch">
                        <case Value="true" />
                        <default><p>{{rules|蛛网强度提高}}</p></default>
                    </switch>
                    <statline Name="SpinDuration" DisplayName="持续时间" Unit="移动行动" />
                    <saveline Name="MoveSave" />
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                    <p>你不会被黏住。</p>
                    <p>与{{w|蛛形纲生物}}的声望+300</p>
                </leveltext>
    </mutation>
    <mutation Name="Stinger (Confusing Venom)" DisplayName="毒刺（致乱毒液）" BearerDescription="毒针含迷乱之毒者">
      <description>
                    <p>你生有一条带毒刺的尾巴，能向敌人注入<stat Name="VenomType" />毒液。</p>
                </description>
      <leveltext>
                    <p>近战攻击时有20%的几率蜇刺对手（<gametext>=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>）</p>
                    <p>毒刺属长刃，只能穿透一次。</p>
                    <p>冲锋或扑击时必定蜇刺。</p>
                    <p>毒刺造成伤害时注入毒液（若毒刺为你的主武器，则仅有20%的几率）。</p>
                    <p>可使用蜇刺主动技能，以毒刺出击，自动命中并穿透。</p>
                    <statline Name="Cooldown" DisplayName="毒刺冷却时间" />
                    <p>毒液令对手陷入混乱，持续<stat Name="Duration" /></p>
                    <p>与{{w|蛛形纲生物}}的声望+200</p>
                </leveltext>
    </mutation>
    <mutation Name="Stinger (Paralyzing Venom)" DisplayName="毒刺（麻痹毒液）" BearerDescription="毒针含麻痹之毒者">
      <description>
                    <p>你生有一条带毒刺的尾巴，能向敌人注入<stat Name="VenomType" />毒液。</p>
                </description>
      <leveltext>
                    <p>近战攻击时有20%的几率蜇刺对手（<gametext>=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>）</p>
                    <p>毒刺属长刃，只能穿透一次。</p>
                    <p>冲锋或扑击时必定蜇刺。</p>
                    <p>毒刺造成伤害时注入毒液（若毒刺为你的主武器，则仅有20%的几率）。</p>
                    <p>可使用蜇刺主动技能，以毒刺出击，自动命中并穿透。</p>
                    <statline Name="Cooldown" DisplayName="毒刺冷却时间" />
                    <p>毒液令对手麻痹，持续<stat Name="Duration" /></p>
                    <p>与{{w|蛛形纲生物}}的声望+200</p>
                </leveltext>
    </mutation>
    <mutation Name="Stinger (Poisoning Venom)" DisplayName="毒刺（中毒毒液）" BearerDescription="毒针含剧毒者">
      <description>
                    <p>你生有一条带毒刺的尾巴，能向敌人注入<stat Name="VenomType" />毒液。</p>
                </description>
      <leveltext>
                    <p>近战攻击时有20%的几率蜇刺对手<gametext>（=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>）</p>
                    <p>毒刺属长刃，只能穿透一次。</p>
                    <p>冲锋或扑击时必定蜇刺。</p>
                    <p>毒刺造成伤害时注入毒液（若毒刺为你的主武器，则仅有20%的几率）。</p>
                    <p>可使用蜇刺主动技能，以毒刺出击，自动命中并穿透。</p>
                    <statline Name="Cooldown" DisplayName="毒刺冷却时间" />
                    <p>毒液令对手中毒，持续<stat Name="Duration" />（伤害增量<stat Name="PoisonDamage" />）</p>
                    <p>与{{w|蛛形纲生物}}的声望+200</p>
                </leveltext>
    </mutation>
    <mutation Name="Thick Fur" DisplayName="厚毛" BearerDescription="毛发浓密者">
      <description>
                    <p>你周身覆着一层厚密的皮毛，足以抵御风霜暑热。</p>
                    <p />
                    <p>+5 热抗</p>
                    <p>+5 寒冷抗性</p>
                    <p>与{{w|猿类}}、{{w|狒狒}}、{{w|熊}}以及{{w|食草享乐主义者}}的声望+100</p>
                </description>
      <leveltext />
    </mutation>
    <mutation Name="Triple-jointed" DisplayName="三重关节" BearerDescription="三节关节者">
      <description>
                    <p>你的关节能伸展到远超常人的幅度。</p>
                </description>
      <leveltext>
