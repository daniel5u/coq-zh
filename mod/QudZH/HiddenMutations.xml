<?xml version='1.0' encoding='utf-8'?>
<mutations Lang="zh" Encoding="utf-8" Hidden="true" ExcludeFromPool="true">
  <category Name="Physical">
    <mutation Name="Dark Vision" DisplayName="暗视" BearerDescription="暗视者">
      <description />
      <leveltext>
                    <p>你能在暗中视物。</p>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Smell" DisplayName="嗅觉增强" BearerDescription="嗅觉敏锐者">
      <description>
                    <p>你生就异常敏锐的嗅觉。</p>
                </description>
      <leveltext>
                    <p>你能察觉一定范围内的生物，范围视地形而定，至多可达<stat Name="Radius" Unit="格" /></p>
                    <switch Name="LevelMatch">
                        <case Value="true"><p>有几率辨识附近已察觉的生物</p></case>
                        <default><p>{{rules|辨识附近已察觉生物的几率提高}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Gills" DisplayName="鳃" BearerDescription="生鳃者" />
    <mutation Name="Infiltrate" DisplayName="潜入" BearerDescription="潜行渗透者">
      <description>
                    <p>你可传送自身，并携带周围生物同行。</p>
                </description>
      <leveltext>
                    <p>你传送至附近某处，并带上半径<stat Name="TeleportRadius" />以内的所有生物同行。</p>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
    <mutation Name="Heat Absorption" DisplayName="热量吸收" BearerDescription="吸热者">
      <description>
                    <p>你通过吸收热量来再生。</p>
                </description>
      <leveltext>
                    <p>免疫热伤害</p>
                    <switch Name="HealFactor">
                        <case Value="0" />
                        <default><p>每当你本应受到热伤害时，改为恢复该伤害<stat Name="HealFactor" />%的生命值</p></default>
                    </switch>
                </leveltext>
    </mutation>
