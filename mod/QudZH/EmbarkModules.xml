<?xml version='1.0' encoding='utf-8'?>
<embarkmodules Lang="zh" Encoding="utf-8">
  <module Class="XRL.CharacterBuilds.Qud.QudGamemodeModule">
    <window ID="Chargen/Modes">
      <title>:选择游戏模式:</title>
      <name>游戏模式</name>
    </window>
    <modes>
      <mode ID="Tutorial" Title="教程">
        <description>
          学习《卡德洞窟》的基础玩法。
              </description>
      </mode>
      <mode ID="Classic" Title="经典">
        <description>
          永久死亡：角色死亡即失去该角色。
              </description>
      </mode>
      <mode ID="Roleplay" Title="角色扮演">
        <description>
          在聚落处设存档点。
              </description>
      </mode>
      <mode ID="Wander" Title="漫游">
        <description>
          {{c|∙}} 多数生物起初对你保持中立。
          {{c|∙}} 击杀不获得经验。
          {{c|∙}} 发现新事物与施行水礼可获得更多经验。
          {{c|∙}} 在聚落处设存档点。
              </description>
      </mode>
      <mode ID="Daily" Title="每日">
        <description>
          {{c|∙}} 角色与世界种子固定，只有一次机会。
          {{c|∙}} 当前为 {{W|=now.year=}} 年第 {{W|=now.dayOfYear=}} 日。
              </description>
      </mode>
    </modes>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudChartypeModule">
    <window ID="Chargen/CharType">
      <name>角色类型</name>
      <title>:选择角色类型:</title>
    </window>
    <types>
      <type ID="Pregen" Title="预设">
        <description>
          从若干预设角色中选择。上手之后，可再行定制。
               </description>
      </type>
      <type ID="New" Title="新建">
        <description>
          创建新角色。
              </description>
      </type>
      <type ID="Random" Title="随机">
        <description>
          随机生成一名角色。
              </description>
      </type>
      <type ID="Library" Title="收藏库">
        <description>
          从你的角色库中选择角色。
              </description>
      </type>
      <type ID="Last" Title="上次">
        <description>
          重玩上次使用的角色。
              </description>
      </type>
    </types>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudBuildLibraryModule">
    <window ID="Chargen/BuildLibrary">
      <name>角色库</name>
      <title>:角色库:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudGenotypeModule">
    <window ID="Chargen/ChooseGenotypes">
      <name>基因型</name>
      <title>:选择基因型:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudPregenModule">
    <window ID="Chargen/Pregens">
      <name>预设角色</name>
      <title>:选择预设:</title>
    </window>
    <pregens>
      <pregen ID="Praetorian Prime" Name="至高禁卫">
        <description>
{{c|∙}} 以冲锋为主的近战战士
{{c|∙}} 初始拥有夜视
{{c|∙}} {{W|生存力最强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="First Gardener" Name="初代园丁">
        <description>
{{c|∙}} 近战与远程兼修
{{c|∙}} 初始拥有烹饪与采集技能
{{c|∙}} {{W|生存力很强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="First Child of the Hearth" Name="炉边初子">
        <description>
{{c|∙}} 近战战士，极耐打的猛士
{{c|∙}} 初始拥有碳化物臂骨
{{c|∙}} {{W|生存力很强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="Marsh Taur" Name="沼地牛人">
        <description>
{{c|∙}} 以冲锋为主的近战战士
{{c|∙}} 能冻结敌人
{{c|∙}} 机动性极高
{{c|∙}} {{W|生存力最强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="Dream Tortoise" Name="梦龟">
        <description>
{{c|∙}} 近战战士
{{c|∙}} 护甲厚重
{{c|∙}} 释放催眠气体使敌人失能
{{c|∙}} {{W|生存力很强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="Gunwing" Name="枪翼">
        <description>
{{c|∙}} 以远程为主的战士
{{c|∙}} 迅捷灵便
{{c|∙}} 能够飞行
{{c|∙}} {{W|生存力很强}}的初始构筑
              </description>
      </pregen>
      <pregen ID="Star-Eye Esper" Name="星眼灵能者">
        <description>
{{c|∙}} 以精神力量为主的远程战士
{{c|∙}} 擅长控场与视野侦查
{{c|∙}} {{W|生存力中等}}的初始构筑
              </description>
      </pregen>
      <pregen ID="Firefrond" Name="火叶簇">
        <description>
{{c|∙}} 近战与精神施术兼修
{{c|∙}} 能使敌人着火
{{c|∙}} 令附近长出可采收的植物
{{c|∙}} {{W|颇具挑战}}的初始构筑
              </description>
      </pregen>
      <pregen ID="bzzzt" Name="滋滋声">
        <description>
{{c|∙}} 近战与电击兼修
{{c|∙}} 擅长掘地与布设陷阱
{{c|∙}} 初始拥有夜视
{{c|∙}} {{W|颇具挑战}}的初始构筑
              </description>
      </pregen>
    </pregens>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudSubtypeModule">
    <window ID="Chargen/ChooseSubtypes">
      <name>亚型</name>
      <title>:选择亚型:</title>
    </window>
    <window ID="Chargen/ChooseSubtypesCategory">
      <name>按类别划分的亚型</name>
      <title>:选择亚型:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudMutationsModule">
    <window ID="Chargen/Mutations">
      <name>变异</name>
      <title>:选择变异:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudAttributesModule">
    <window ID="Chargen/PickAttributes">
      <title>:分配属性:</title>
      <name>属性</name>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudCyberneticsModule">
    <window ID="Chargen/Cybernetic">
      <name>义体</name>
      <title>:选择义体植入物:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudBuildSummaryModule">
    <window ID="Chargen/BuildSummary">
      <name>摘要</name>
      <title>:构筑摘要:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudCustomizeCharacterModule">
    <window ID="Chargen/Customize">
      <name>定制</name>
      <title>:定制角色:</title>
    </window>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudChooseStartingLocationModule">
    <window ID="Chargen/ChooseStartingLocation">
      <name>起始地点</name>
      <title>:选择起始地点:</title>
    </window>
    <locations>
      <location ID="Joppa" Name="{{Y|约帕}}">
        <description>
          推荐新玩家选择。
              </description>
      </location>
      <location ID="SaltMarshVillage" Name="{{G|盐沼}}&#10;村庄">
        <description>
          {{c|∙}} 盐沼中的随机村落。
          {{c|∙}} 村中教授采收术。
          {{c|∙}} 与昆虫、鱼类的声望 +50。
          {{c|∙}} 初始持有一双{{g|鳄皮{{G|软}}鞋}}。
              </description>
      </location>
      <location ID="SaltDuneVillage" Name="{{Y|盐丘}}&#10;村庄">
        <description>
          {{c|∙}} 盐丘中的随机村落。
          {{c|∙}} 村中教授断食之道。
          {{c|∙}} 与爬行动物的声望 +100。
          {{c|∙}} 初始持有一面{{Y|以萨{{r|迦}}}}旗。
              </description>
      </location>
      <location ID="DesertCanyonsVillage" Name="{{W|沙漠峡谷}}&#10;村庄">
        <description>
          {{c|∙}} 沙漠峡谷中的随机村落。
          {{c|∙}} 村中教授旅途行术。
          {{c|∙}} 与马类、陆龟、藤蔓的声望 +50。
              </description>
      </location>
      <location ID="HillsVillage" Name="{{Y|丘陵}}&#10;村庄">
        <description>
          {{c|∙}} 丘陵中的随机村落。
          {{c|∙}} 村中教授屠宰术。
          {{c|∙}} 与隐士的声望 +100。
          {{c|∙}} 初始持有一枚{{r|血迹斑斑}}的颈环
              </description>
      </location>
      <location ID="JoppaTutorial" Name="一座沉没的商队客栈">
        <description>
          你抵达卡德的边陲。
              </description>
      </location>
    </locations>
  </module>
</embarkmodules>