{"id": "WorldTerrain#00086", "file": "WorldTerrain", "tag": "part", "attr": "Short", "path": "[objects][object,Name=TerrainRuins][part,Name=Description]", "src": "Here crumble the mysterious Eaters' vine-swathed works, spun on the cyclopean lathe in an ageless past. Chrome steeples and parapets that rise above the clutches of shale hint at the labyrinths beneath them."}
{"id": "WorldTerrain#00087", "file": "WorldTerrain", "tag": "part", "attr": "DisplayName", "path": "[objects][object,Name=TerrainBaroqueRuins][part,Name=Render]", "src": "baroque ruins"}
{"id": "WorldTerrain#00088", "file": "WorldTerrain", "tag": "part", "attr": "Short", "path": "[objects][object,Name=TerrainBaroqueRuins][part,Name=Description]", "src": "Rampant greenspread canopies a starburst of the Eaters' richest works. The jungle is torn at the corners, where crysteel balustrades and star orchid lancets peek through."}
{"id": "WorldTerrain#00089", "file": "WorldTerrain", "tag": "part", "attr": "DisplayName", "path": "[objects][object,Name=TerrainJoppa][part,Name=Render]", "src": "Joppa"}
{"id": "WorldTerrain#00090", "file": "WorldTerrain", "tag": "part", "attr": "Short", "path": "[objects][object,Name=TerrainJoppa][part,Name=Description]", "src": "Ants in the viridian chaff, the farmers sap the last drops of pristine moisture out of the salt-spangled earth."}
