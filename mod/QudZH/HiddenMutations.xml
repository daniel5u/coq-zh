    <mutation Name="Plasma Emission" DisplayName="等离子体喷发" BearerDescription="放射等离子者">
      <description>
                    <p>你在自身周围释放一团<stat Name="GasName" />。</p>
                </description>
      <leveltext>
                    <p>释放气体，持续<stat Name="Duration" /></p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|<stat Name="LevelEffectDescription" />提高}}</p></case>
                        <case Value="lower"><p>{{rules|<stat Name="LevelEffectDescription" />降低}}</p></case>
                    </switch>
                    <statline Name="Cooldown" DisplayName="冷却时间" />
                </leveltext>
    </mutation>
